# Copy to .env and adjust. All VITE_* values are public (bundled into the browser) — never put secrets here.
VITE_SITE_URL=https://bgvsacc.org
VITE_COLLEGE_NAME=Bapuji College Karwar
# Show "Demo content" labels on illustrative data (set to false once verified content is loaded)
VITE_DEMO_MODE=true
# API base URL for enquiry/feedback/alumni form submissions. Leave empty to use the local mock service.
VITE_API_BASE_URL=
# WhatsApp number in international format without + (leave empty to hide the floating shortcut)
VITE_WHATSAPP_NUMBER=919800000000
# Google Maps embed URL for the contact page
VITE_MAP_EMBED_URL=https://maps.google.com/maps?q=Bapuji%20Grameena%20Vikasa%20Samiti%27s%20Arts%20and%20Commerce%20College%2C%20Sadashivgad%2C%20Karwar&t=m&z=16&output=embed
# External portals (leave empty to show "integration pending" states)
VITE_ERP_URL=
VITE_LMS_URL=
VITE_RESULTS_URL=
VITE_APPLICATION_PORTAL_URL=
